---
import { ads } from "../ads";
import AdCard from "../components/AdCard.astro";
import CaseIndex from "../components/CaseIndex.astro";
import "../styles/global.css";

const linkedin = "https://www.linkedin.com/in/virginialovotti/";
const description =
  "Virginia’s paid social creative for Dr. Woof: seven ads, each read as its own case against the account average.";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Virginia · Paid social creative</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafafa" />
    <link rel="preload" href="/fonts/Satoshi-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Satoshi-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <header class="nav wrap">
      <a class="nav__mark" href="/" aria-label="Virginia, home">
        <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
          <rect x="0.75" y="0.75" width="18.5" height="18.5" rx="5" fill="none" stroke="currentColor" stroke-width="1.5" />
          <path d="M5.5 6 10 14.5 14.5 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Virginia
      </a>
      <nav class="nav__links" aria-label="Page">
        <a href="#cases">Cases</a>
        <a href="#reading">How to read the numbers</a>
      </nav>
      <a class="btn nav__cta" href={linkedin} rel="me noopener" target="_blank">
        LinkedIn
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
          <path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </header>

    <main>
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero__copy">
          <h1 class="hero__title" id="hero-title">
            Paid social, measured<br /> against the account.
          </h1>
          <p class="hero__deck">Seven Dr. Woof ads, each judged against the account average.</p>
          <div class="hero__actions">
            <a class="btn btn--primary" href={linkedin} rel="me noopener" target="_blank">
              <span class="btn__dot" aria-hidden="true"></span>
              Contact on LinkedIn
            </a>
            <a class="btn" href="#cases">
              See the cases
              <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
        </div>
        <div class="hero__proof">
          <CaseIndex ads={ads} />
        </div>
      </section>

      <section class="key wrap" id="reading" aria-labelledby="key-title">
        <h2 class="key__title" id="key-title">How to read<br /> the numbers</h2>
        <dl class="key__items">
          <div>
            <dt class="key__delta"><span class="num">2.33 (+75%)</span></dt>
            <dd>The figure in parentheses is the difference from the Dr. Woof account average.</dd>
          </div>
          <div>
            <dt>Days on air</dt>
            <dd>How long each ad ran. Launch and end dates are left out.</dd>
          </div>
          <div>
            <dt>Spend and revenue</dt>
            <dd>Withheld for this account. Efficiency is shown through ROAS and CPA.</dd>
          </div>
        </dl>
      </section>

      <section class="cases wrap" id="cases" aria-labelledby="cases-title">
        <header class="cases__head">
          <h2 class="section-title" id="cases-title">Seven cases from one account</h2>
          <p>
            Five ads built to convert and two built to stop the scroll. Each one is judged on the job it was
            made for.
          </p>
        </header>

        <div class="cases__grid">
          {ads.map((ad) => <AdCard ad={ad} />)}

          <aside class="close" aria-labelledby="close-title" data-rise>
            <h2 class="close__title" id="close-title">Hiring for performance creative?</h2>
            <p>
              Virginia makes paid social creative that is judged on how it performs. Reach her on LinkedIn.
            </p>
            <a class="btn btn--primary" href={linkedin} rel="me noopener" target="_blank">
              <span class="btn__dot" aria-hidden="true"></span>
              Contact on LinkedIn
            </a>
          </aside>
        </div>
      </section>
    </main>

    <footer class="foot wrap">
      <span>Virginia · @Virginia</span>
      <span>Dr. Woof figures are relative to the account average. Spend and revenue are withheld.</span>
    </footer>

    <script>
      const rising = document.querySelectorAll<HTMLElement>("[data-rise]");
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add("is-in");
            observer.unobserve(entry.target);
          }
        },
        { rootMargin: "0px 0px -8% 0px", threshold: 0.12 },
      );
      rising.forEach((el, i) => {
        el.style.setProperty("--rise-delay", `${(i % 2) * 90}ms`);
        observer.observe(el);
      });

      const videos = [...document.querySelectorAll<HTMLVideoElement>("[data-video]")];
      document.querySelectorAll<HTMLButtonElement>("[data-play]").forEach((button) => {
        const screen = button.closest<HTMLElement>("[data-screen]");
        const video = screen?.querySelector<HTMLVideoElement>("[data-video]");
        if (!screen || !video) return;
        button.addEventListener("click", () => {
          videos.forEach((other) => other !== video && other.pause());
          video.controls = true;
          video.muted = false;
          screen.classList.add("is-playing");
          video.play().catch(() => {
            video.muted = true;
            video.play();
          });
          video.focus();
        });
      });
    </script>
  </body>
</html>

<style>
  .nav {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 84px;
  }

  .nav__mark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--n-7);
    text-decoration: none;
  }

  .nav__links {
    display: flex;
    gap: 28px;
    margin-left: auto;
    font-size: 0.9375rem;
  }

  .nav__links a {
    color: var(--n-5);
    text-decoration: none;
    transition: color 140ms var(--ease-out);
  }

  .nav__links a:hover {
    color: var(--n-7);
  }

  .nav__cta {
    height: 38px;
    padding: 0 14px;
    font-size: 0.875rem;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    align-items: center;
    gap: clamp(40px, 4.5vw, 72px);
    padding-block: clamp(32px, 5vw, 72px) clamp(56px, 7vw, 96px);
  }

  .hero__title {
    margin: 0;
    font-size: clamp(2.375rem, 1.5rem + 2.4vw, 3.5rem);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.035em;
    text-wrap: balance;
    color: var(--n-7);
  }

  .hero__deck {
    max-width: 52ch;
    margin: 28px 0 0;
    font-size: 1.125rem;
    line-height: 1.55;
    color: var(--n-5);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .hero__proof {
    position: relative;
    padding: clamp(16px, 2.5vw, 36px);
    border-radius: 28px;
    background:
      radial-gradient(90% 70% at 70% 10%, #fff 0%, rgb(255 255 255 / 0) 70%),
      radial-gradient(120% 100% at 50% 100%, #e4e4e4 0%, var(--n-1) 60%);
  }

  .key {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: 40px;
    padding-block: 32px;
    border-block: 1px solid var(--n-2);
  }

  .key__title {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--n-7);
  }

  .key__items {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
  }

  .key__items > div {
    padding: 0 28px;
    border-left: 1px solid var(--n-2);
  }

  .key__items dt {
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--n-7);
  }

  .key__delta {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .key__delta::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px rgb(166 194 63 / 0.22);
  }

  .key__items dd {
    margin: 6px 0 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--n-5);
  }

  .cases {
    padding-block: clamp(80px, 10vw, 136px) clamp(64px, 8vw, 112px);
  }

  .cases__head {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    align-items: end;
    gap: 24px 40px;
    margin-bottom: clamp(36px, 4vw, 56px);
  }

  .section-title {
    margin: 0;
    font-size: clamp(2rem, 1.5rem + 1.8vw, 3rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-wrap: balance;
    color: var(--n-7);
  }

  .cases__head p {
    max-width: 44ch;
    margin: 0;
    font-size: 1.0625rem;
    color: var(--n-5);
  }

  .cases__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .close {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    gap: 20px;
    padding: clamp(28px, 3.5vw, 48px);
    border-radius: 20px;
    background:
      radial-gradient(110% 90% at 85% 0%, #fff 0%, rgb(255 255 255 / 0) 60%),
      radial-gradient(130% 120% at 0% 100%, #e2e2e2 0%, var(--n-1) 65%);
    box-shadow: 0 0 0 1px var(--n-2);
  }

  .close__title {
    margin: 0;
    font-size: clamp(1.75rem, 1.35rem + 1.4vw, 2.5rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.03em;
    text-wrap: balance;
    color: var(--n-7);
  }

  .close p {
    max-width: 40ch;
    margin: 0 0 8px;
    color: var(--n-5);
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-block: 28px 40px;
    border-top: 1px solid var(--n-2);
    font-size: 0.8125rem;
    color: var(--n-5);
  }

  @media (max-width: 1080px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .hero__copy {
      max-width: 640px;
    }

    .cases__grid {
      grid-template-columns: 1fr;
    }

    .cases__head {
      grid-template-columns: 1fr;
    }

    .close {
      min-height: 320px;
    }
  }

  @media (max-width: 760px) {
    .nav__links {
      display: none;
    }

    .nav__cta {
      margin-left: auto;
    }

    .key {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .key__title br,
    .hero__title br {
      display: none;
    }

    .key__items {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .key__items > div {
      padding: 0 0 0 16px;
    }
  }
</style>
