---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { ads } from "../ads";
import AdCard from "../components/AdCard.astro";
import CaseIndex from "../components/CaseIndex.astro";
import CreativeLightbox from "../components/CreativeLightbox.astro";
import "../styles/global.css";

const caseStudies = (await getCollection("case-studies")).sort(
  (a, b) => a.data.order - b.data.order,
);

const linkedin = "https://www.linkedin.com/in/virginialovotti/";
const site = Astro.site ?? new URL("https://virlovotti.github.io");
const canonicalURL = new URL(Astro.url.pathname, site);
const title = "Virginia Lovotti · Creative Strategist";
const description =
  "Paid social creative portfolio for DTC brands—winning ads, performance metrics vs. account benchmarks, and case studies by Virginia Lovotti.";
const ogImage = new URL("/og.png", site);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  name: title,
  description,
  url: canonicalURL.href,
  inLanguage: "en-US",
  mainEntity: {
    "@type": "Person",
    name: "Virginia Lovotti",
    jobTitle: "Creative Strategist",
    url: site.href,
    sameAs: [linkedin],
  },
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />
    <meta name="theme-color" content="#fafafa" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Virginia Lovotti" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Virginia Lovotti — Creative Strategist portfolio" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />
    <meta name="twitter:image:alt" content="Virginia Lovotti — Creative Strategist portfolio" />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <link rel="preload" href="/fonts/Satoshi-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Satoshi-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <header class="nav wrap" data-nav>
      <a class="nav__mark" href="/" aria-label="Virginia Lovotti, home">
        <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
          <rect x="0.75" y="0.75" width="18.5" height="18.5" rx="5" fill="none" stroke="currentColor" stroke-width="1.5" />
          <path d="M5.5 6 10 14.5 14.5 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Virginia Lovotti
      </a>
      <nav class="nav__links" aria-label="Page">
        <a href="#cases">Latest ads</a>
        <a class="nav__links-short" href="#reading">How to read</a>
        <a href="#case-studies">Case studies</a>
      </nav>
      <a class="btn nav__cta" href={linkedin} rel="me noopener" target="_blank">
        LinkedIn
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
          <path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </header>

    <main>
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero__copy">
          <p class="hero__identity">
            <span class="hero__name">Virginia Lovotti</span>
            <span class="hero__sep" aria-hidden="true">·</span>
            <span class="hero__role">Creative Strategist</span>
          </p>
          <h1 class="hero__title" id="hero-title">
            A selection of winning paid social ads for DTC brands.
          </h1>
          <div class="hero__actions">
            <a class="btn btn--primary" href={linkedin} rel="me noopener" target="_blank">
              <span class="btn__dot" aria-hidden="true"></span>
              Contact on LinkedIn
            </a>
            <a class="btn" href="#cases">
              See the results
              <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
        </div>
        <div class="hero__proof">
          <CaseIndex ads={ads} />
        </div>
      </section>

      <section class="key wrap" id="reading" aria-labelledby="key-title">
        <h2 class="key__title" id="key-title">How to read<br /> the numbers</h2>
        <dl class="key__items">
          <div>
            <dt class="key__delta"><span class="num">2.33 (+75%)</span></dt>
            <dd>The figure in parentheses is the difference from the account average.</dd>
          </div>
          <div>
            <dt>Days on air</dt>
            <dd>How long each ad ran. Launch and end dates are left out.</dd>
          </div>
          <div>
            <dt>Spend and revenue</dt>
            <dd>Withheld for this account. Efficiency is shown through ROAS and CPA.</dd>
          </div>
        </dl>
      </section>

      <section class="cases wrap" id="cases" aria-labelledby="cases-title">
        <div class="cases__head" data-rise>
          <h2 class="section-title" id="cases-title">Latest ads</h2>
        </div>
        <div class="cases__grid">
          {ads.map((ad) => <AdCard ad={ad} />)}

          <aside class="close" aria-labelledby="close-title" data-rise>
            <h2 class="close__title" id="close-title">Hiring for performance creative?</h2>
            <p>
              Virginia makes paid social creative that is judged on how it performs. Reach her on LinkedIn.
            </p>
            <div class="close__actions">
              <a class="btn btn--primary" href={linkedin} rel="me noopener" target="_blank">
                <span class="btn__dot" aria-hidden="true"></span>
                Contact on LinkedIn
              </a>
              <a class="btn" href="#case-studies">
                Read the case studies
              </a>
            </div>
          </aside>
        </div>
      </section>

      <section class="studies wrap" id="case-studies" aria-labelledby="studies-title">
        <div class="studies__head" data-rise>
          <h2 class="section-title" id="studies-title">The thinking behind the work</h2>
          <p>
            Long-form case studies on customer research, creative strategy and product design.
          </p>
        </div>

        <ul class="studies__grid">
          {
            caseStudies.map((study) => (
              <li class="study" data-rise>
                <div class="study__cover">
                  <Image
                    src={study.data.cover}
                    alt=""
                    widths={[320, 480, 720]}
                    sizes="(max-width: 1080px) 92vw, 360px"
                  />
                </div>
                <div class="study__body">
                  <h3 class="study__title">
                    <a class="study__link" href={`/case-studies/${study.id}`}>
                      {study.data.title}
                    </a>
                  </h3>
                  <p class="study__summary">{study.data.summary}</p>
                  <ul class="study__skills" aria-label="Skills">
                    {study.data.skills.slice(0, 3).map((skill) => (
                      <li class="study__chip">{skill}</li>
                    ))}
                  </ul>
                  <span class="study__cta" aria-hidden="true">
                    Read case study
                    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                      <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                </div>
              </li>
            ))
          }
        </ul>
      </section>
    </main>

    <CreativeLightbox />

    <footer class="foot wrap">
      <span>Virginia Lovotti · 2026</span>
    </footer>

    <script>
      const rising = document.querySelectorAll<HTMLElement>("[data-rise]");
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add("is-in");
            observer.unobserve(entry.target);
          }
        },
        { rootMargin: "0px 0px -8% 0px", threshold: 0.12 },
      );
      rising.forEach((el, i) => {
        el.style.setProperty("--rise-delay", `${(i % 2) * 90}ms`);
        observer.observe(el);
      });

      const nav = document.querySelector<HTMLElement>("[data-nav]");
      const syncNavOffset = () => {
        if (!nav) return;
        document.documentElement.style.setProperty("--nav-offset", `${nav.offsetHeight}px`);
      };
      const scrollInset = () => {
        const offset = parseFloat(
          getComputedStyle(document.documentElement).getPropertyValue("--scroll-offset"),
        );
        return Number.isFinite(offset) ? offset : (nav?.offsetHeight ?? 84) + 20;
      };

      const scrollToHash = (hash = location.hash, behavior: ScrollBehavior = "auto") => {
        if (!hash || hash === "#") return;
        const target = document.querySelector<HTMLElement>(hash);
        if (!target) return;
        const top = Math.max(0, window.scrollY + target.getBoundingClientRect().top - scrollInset());
        window.scrollTo({ top, behavior });
      };

      syncNavOffset();
      if (nav) new ResizeObserver(syncNavOffset).observe(nav);
      scrollToHash(location.hash);

      let navCompact = false;
      const syncNavCompact = () => {
        const y = window.scrollY;
        const next = y > 48 ? true : y < 16 ? false : navCompact;
        if (next === navCompact) return;
        navCompact = next;
        nav?.classList.toggle("is-compact", navCompact);
      };
      syncNavCompact();
      window.addEventListener("scroll", syncNavCompact, { passive: true });

      const highlightCase = (hash: string) => {
        document.querySelectorAll<HTMLElement>("[data-ad].is-highlighted").forEach((el) => {
          el.classList.remove("is-highlighted");
        });
        if (!hash.startsWith("#") || hash === "#cases" || hash === "#reading") return;
        const target = document.querySelector<HTMLElement>(hash);
        if (!target?.matches("[data-ad]")) return;
        target.classList.add("is-highlighted");
        window.setTimeout(() => target.classList.remove("is-highlighted"), 2400);
      };

      const onHashChange = () => {
        requestAnimationFrame(() => {
          const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          scrollToHash(location.hash, reduced ? "auto" : "smooth");
          highlightCase(location.hash);
        });
      };

      document.addEventListener("click", (event) => {
        const link = (event.target as Element | null)?.closest?.('a[href^="#"]');
        if (!(link instanceof HTMLAnchorElement)) return;
        const hash = link.getAttribute("href");
        if (!hash || hash === "#") return;
        if (link.pathname !== location.pathname) return;
        if (!document.querySelector(hash)) return;
        event.preventDefault();
        if (location.hash !== hash) history.pushState(null, "", hash);
        onHashChange();
      });

      highlightCase(location.hash);
      window.addEventListener("hashchange", onHashChange);
      window.addEventListener("popstate", onHashChange);

      const lightbox = document.querySelector<HTMLElement>("[data-lightbox]");
      const dialog = lightbox?.querySelector<HTMLElement>("[data-lightbox-dialog]");
      const stage = lightbox?.querySelector<HTMLElement>("[data-lightbox-stage]");
      let lastFocus: HTMLElement | null = null;
      let lightboxVideo: HTMLVideoElement | null = null;

      const focusables = () =>
        lightbox
          ? [...lightbox.querySelectorAll<HTMLElement>(
              'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])',
            )].filter((el) => !el.hasAttribute("disabled") && el.offsetParent !== null)
          : [];

      const trapFocus = (event: KeyboardEvent) => {
        if (event.key !== "Tab" || lightbox?.hidden) return;
        const items = focusables();
        if (!items.length) return;
        const first = items[0];
        const last = items[items.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      };

      const closeLightbox = () => {
        if (!lightbox || !stage) return;
        lightbox.hidden = true;
        document.body.style.overflow = "";
        lightboxVideo?.pause();
        lightboxVideo = null;
        stage.innerHTML = "";
        document.removeEventListener("keydown", onLightboxKey);
        lastFocus?.focus();
        lastFocus = null;
      };

      const onLightboxKey = (event: KeyboardEvent) => {
        if (event.key === "Escape") {
          event.preventDefault();
          closeLightbox();
          return;
        }
        trapFocus(event);
      };

      const openLightbox = (button: HTMLButtonElement) => {
        if (!lightbox || !stage || !dialog) return;
        const kind = button.dataset.lightboxKind;
        const src = button.dataset.lightboxSrc;
        if (!kind || !src) return;

        lastFocus = button;
        stage.innerHTML = "";

        if (kind === "image") {
          const img = document.createElement("img");
          img.src = src;
          img.alt = button.getAttribute("aria-label") ?? "Ad creative";
          img.decoding = "async";
          stage.append(img);
        } else {
          const video = document.createElement("video");
          video.src = src;
          video.controls = true;
          video.playsInline = true;
          if (button.dataset.lightboxPoster) video.poster = button.dataset.lightboxPoster;
          video.setAttribute("aria-label", button.getAttribute("aria-label") ?? "Ad video");
          stage.append(video);
          lightboxVideo = video;
          video.play().catch(() => {
            video.muted = true;
            video.play();
          });
        }

        lightbox.hidden = false;
        document.body.style.overflow = "hidden";
        document.addEventListener("keydown", onLightboxKey);
        dialog.querySelector<HTMLButtonElement>("[data-lightbox-close]")?.focus();
      };

      document.querySelectorAll<HTMLButtonElement>("[data-lightbox-open]").forEach((button) => {
        button.addEventListener("click", () => openLightbox(button));
      });

      lightbox?.querySelector("[data-lightbox-dismiss]")?.addEventListener("click", closeLightbox);
      lightbox?.querySelector("[data-lightbox-close]")?.addEventListener("click", closeLightbox);
    </script>
  </body>
</html>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    gap: 32px;
    min-height: 84px;
    padding-block: 18px;
    background: transparent;
    transition: box-shadow 200ms var(--ease-out);
  }

  .nav::before {
    content: "";
    position: absolute;
    z-index: -1;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
    background: rgb(250 250 250 / 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid transparent;
    transition:
      background-color 200ms var(--ease-out),
      border-color 200ms var(--ease-out),
      backdrop-filter 200ms var(--ease-out);
  }

  .nav.is-compact {
    box-shadow: 0 8px 24px -20px rgb(17 17 17 / 0.35);
  }

  .nav.is-compact::before {
    background: var(--n-0);
    backdrop-filter: none;
    border-color: var(--n-2);
  }

  .nav__mark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--n-7);
    text-decoration: none;
  }

  .nav__links {
    display: flex;
    gap: 28px;
    margin-left: auto;
    font-size: 0.9375rem;
  }

  .nav__links a {
    color: var(--n-5);
    text-decoration: none;
    transition: color 140ms var(--ease-out);
  }

  .nav__links a:hover {
    color: var(--n-7);
  }

  .nav__cta {
    height: 38px;
    padding: 0 14px;
    font-size: 0.875rem;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    align-items: center;
    gap: clamp(40px, 4.5vw, 72px);
    padding-block: clamp(32px, 5vw, 72px) clamp(56px, 7vw, 96px);
  }

  .hero__identity {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 8px;
    margin: 0 0 16px;
    font-size: clamp(1.0625rem, 0.95rem + 0.35vw, 1.25rem);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--n-7);
  }

  .hero__sep {
    color: var(--n-5);
  }

  .hero__role {
    color: var(--n-5);
    font-weight: 400;
  }

  .hero__title {
    margin: 0;
    font-size: clamp(2.375rem, 1.5rem + 2.4vw, 3.5rem);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.035em;
    text-wrap: balance;
    color: var(--n-7);
  }

  .hero__deck {
    max-width: 52ch;
    margin: 28px 0 0;
    font-size: 1.125rem;
    line-height: 1.55;
    color: var(--n-5);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .hero__proof {
    position: relative;
    padding: clamp(16px, 2.5vw, 36px);
    border-radius: 28px;
    background:
      radial-gradient(90% 70% at 70% 10%, #fff 0%, rgb(255 255 255 / 0) 70%),
      radial-gradient(120% 100% at 50% 100%, #e4e4e4 0%, var(--n-1) 60%);
  }

  .key {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: 40px;
    padding-block: 32px;
    border-block: 1px solid var(--n-2);
    scroll-margin-top: var(--scroll-offset);
  }

  .key__title {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--n-7);
  }

  .key__items {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
  }

  .key__items > div {
    padding: 0 28px;
    border-left: 1px solid var(--n-2);
  }

  .key__items dt {
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--n-7);
  }

  .key__delta {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .key__delta::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px rgb(166 194 63 / 0.22);
  }

  .key__items dd {
    margin: 6px 0 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--n-5);
  }

  .cases {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-block: clamp(80px, 10vw, 136px) clamp(64px, 8vw, 112px);
    scroll-margin-top: var(--scroll-offset);
  }

  .cases__head {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    align-items: end;
    gap: 24px 40px;
    margin-bottom: clamp(36px, 4vw, 56px);
  }

  .section-title {
    margin: 0;
    font-size: clamp(2rem, 1.5rem + 1.8vw, 3rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-wrap: balance;
    color: var(--n-7);
  }

  .cases__head p {
    max-width: 44ch;
    margin: 0;
    font-size: 1.0625rem;
    color: var(--n-5);
  }

  .cases__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .studies {
    display: flex;
    flex-direction: column;
    gap: clamp(36px, 4vw, 56px);
    padding-block: clamp(64px, 8vw, 112px);
    border-top: 1px solid var(--n-2);
    scroll-margin-top: var(--scroll-offset);
  }

  .studies__head {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    align-items: end;
    gap: 24px 40px;
  }

  .studies__head p {
    max-width: 44ch;
    margin: 0;
    font-size: 1.0625rem;
    color: var(--n-5);
  }

  .studies__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .study {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 18px;
    background: var(--n-white);
    box-shadow:
      0 0 0 1px var(--n-2),
      0 1px 2px rgb(17 17 17 / 0.04);
    transition:
      box-shadow 240ms var(--ease-out),
      transform 240ms var(--ease-out);
  }

  .study:hover {
    box-shadow:
      0 0 0 1px var(--n-3),
      0 18px 40px -24px rgb(17 17 17 / 0.3);
    transform: translateY(-2px);
  }

  .study:has(.study__link:focus-visible) {
    outline: 2px solid var(--n-7);
    outline-offset: 3px;
  }

  .study__cover {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--n-1);
  }

  .study__cover :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .study__cover :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .study__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 12px;
    padding: 20px;
  }

  .study__title {
    margin: 0;
    font-size: 1.1875rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-wrap: balance;
    color: var(--n-7);
  }

  .study__link {
    color: inherit;
    text-decoration: none;
  }

  .study__link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .study__link:focus-visible {
    outline: none;
  }

  .study__summary {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--n-5);
  }

  .study__skills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
