---
import { getCollection, render } from "astro:content";
import "../../styles/global.css";

export async function getStaticPaths() {
  const entries = (await getCollection("case-studies")).sort(
    (a, b) => a.data.order - b.data.order,
  );
  return entries.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, next: entries[(index + 1) % entries.length] },
  }));
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);
const { title, summary, role, skills } = entry.data;

const linkedin = "https://www.linkedin.com/in/virginialovotti/";
const site = Astro.site ?? new URL("https://virlovotti.github.io");
const canonicalURL = new URL(Astro.url.pathname, site);
const pageTitle = `${title} · Virginia Lovotti`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={summary} />
    <link rel="canonical" href={canonicalURL.href} />
    <meta name="theme-color" content="#fafafa" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preload" href="/fonts/Satoshi-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Satoshi-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <header class="nav wrap" data-nav>
      <a class="nav__mark" href="/" aria-label="Virginia Lovotti, home">
        <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
          <rect x="0.75" y="0.75" width="18.5" height="18.5" rx="5" fill="none" stroke="currentColor" stroke-width="1.5" />
          <path d="M5.5 6 10 14.5 14.5 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Virginia Lovotti
      </a>
      <nav class="nav__links" aria-label="Page">
        <a href="/#cases">Latest ads</a>
        <a class="nav__links-short" href="/#reading">How to read</a>
        <a href="/#case-studies">Case studies</a>
      </nav>
      <a class="btn nav__cta" href={linkedin} rel="me noopener" target="_blank">
        LinkedIn
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
          <path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </header>

    <main class="cs wrap">
      <article>
        <header class="cs__head">
          <p class="cs__eyebrow">Case study</p>
          <h1 class="cs__title">{title}</h1>
          <p class="cs__summary">{summary}</p>
          <dl class="cs__meta">
            <div class="cs__meta-group">
              <dt>Role</dt>
              <dd>{role}</dd>
            </div>
            <div class="cs__meta-group">
              <dt>Skills</dt>
              <dd>
                <ul class="cs__skills">
                  {skills.map((skill) => <li class="cs__chip">{skill}</li>)}
                </ul>
              </dd>
            </div>
          </dl>
        </header>

        <div class="cs__body">
          <Content />
        </div>

        <nav class="cs__nav" aria-label="More case studies">
          <a class="cs__next" href={`/case-studies/${next.id}`}>
            <span class="cs__next-label">Next case study</span>
            <span class="cs__next-title">
              {next.data.title}
              <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </a>
          <a class="cs__back" href="/#case-studies">Back to all work</a>
        </nav>
      </article>
    </main>

    <footer class="foot wrap">
      <span>Virginia Lovotti · 2026</span>
    </footer>

    <script>
      const nav = document.querySelector<HTMLElement>("[data-nav]");
      const syncNavOffset = () => {
        if (!nav) return;
        document.documentElement.style.setProperty("--nav-offset", `${nav.offsetHeight}px`);
      };
      syncNavOffset();
      if (nav) new ResizeObserver(syncNavOffset).observe(nav);

      let navCompact = false;
      const syncNavCompact = () => {
        const y = window.scrollY;
        const next = y > 48 ? true : y < 16 ? false : navCompact;
        if (next === navCompact) return;
        navCompact = next;
        nav?.classList.toggle("is-compact", navCompact);
      };
      syncNavCompact();
      window.addEventListener("scroll", syncNavCompact, { passive: true });
    </script>

    <style>
      .nav {
        position: sticky;
        top: 0;
        z-index: 100;
        display: flex;
        align-items: center;
        gap: 32px;
        min-height: 84px;
        padding-block: 18px;
        background: transparent;
        transition: box-shadow 200ms var(--ease-out);
      }

      .nav::before {
        content: "";
        position: absolute;
        z-index: -1;
        top: 0;
        bottom: 0;
        left: 50%;
        width: 100vw;
        transform: translateX(-50%);
        background: rgb(250 250 250 / 0.92);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid transparent;
        transition:
          background-color 200ms var(--ease-out),
          border-color 200ms var(--ease-out),
          backdrop-filter 200ms var(--ease-out);
      }

      .nav.is-compact {
        box-shadow: 0 8px 24px -20px rgb(17 17 17 / 0.35);
      }

      .nav.is-compact::before {
        background: var(--n-0);
        backdrop-filter: none;
        border-color: var(--n-2);
      }

      .nav__mark {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: 1.125rem;
        font-weight: 500;
        letter-spacing: -0.01em;
        color: var(--n-7);
        text-decoration: none;
      }

      .nav__links {
        display: flex;
        gap: 28px;
        margin-left: auto;
        font-size: 0.9375rem;
      }

      .nav__links a {
        color: var(--n-5);
        text-decoration: none;
        transition: color 140ms var(--ease-out);
      }

      .nav__links a:hover {
        color: var(--n-7);
      }

      .nav__cta {
        height: 38px;
        padding: 0 14px;
        font-size: 0.875rem;
      }

      .nav__links-short {
        display: none;
      }

      .cs {
        padding-block: clamp(32px, 5vw, 64px) clamp(56px, 7vw, 96px);
      }

      .cs__head {
        max-width: 760px;
      }

      .cs__eyebrow {
        margin: 0 0 14px;
        font-size: 0.8125rem;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--n-5);
      }

      .cs__title {
        margin: 0;
        font-size: clamp(2.125rem, 1.5rem + 2vw, 3.25rem);
        font-weight: 500;
        line-height: 1.06;
        letter-spacing: -0.035em;
        text-wrap: balance;
        color: var(--n-7);
      }

      .cs__summary {
        margin: 20px 0 0;
        max-width: 60ch;
        font-size: clamp(1.0625rem, 0.98rem + 0.4vw, 1.25rem);
        line-height: 1.5;
        color: var(--n-5);
      }

      .cs__meta {
        display: flex;
        flex-wrap: wrap;
        gap: 24px 48px;
        margin: 32px 0 0;
        padding-top: 24px;
        border-top: 1px solid var(--n-2);
      }

      .cs__meta-group {
        min-width: 0;
      }

      .cs__meta dt {
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--n-5);
      }

      .cs__meta dd {
        margin: 8px 0 0;
        font-size: 1rem;
        color: var(--n-7);
      }

      .cs__skills {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .cs__chip {
        display: inline-flex;
        align-items: center;
        height: 28px;
        padding: 0 12px;
        border: 1px solid var(--n-3);
        border-radius: 999px;
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--n-7);
        white-space: nowrap;
      }

      .cs__body {
        max-width: 880px;
        margin: clamp(40px, 5vw, 64px) auto 0;
      }

      .cs__body > :global(* + *) {
        margin-top: 1.25em;
      }

      .cs__body :global(h1),
      .cs__body :global(h2),
      .cs__body :global(h3),
      .cs__body :global(h4),
      .cs__body :global(p),
      .cs__body :global(ul),
      .cs__body :global(ol),
      .cs__body :global(blockquote) {
        max-width: 70ch;
        margin-inline: auto;
      }

      .cs__body :global(h2) {
        margin-top: 2em;
        font-size: clamp(1.5rem, 1.25rem + 0.9vw, 2rem);
        font-weight: 500;
        line-height: 1.15;
        letter-spacing: -0.025em;
        text-wrap: balance;
        color: var(--n-7);
      }

      .cs__body :global(h3) {
        margin-top: 1.75em;
        font-size: clamp(1.1875rem, 1.05rem + 0.5vw, 1.4rem);
        font-weight: 500;
        line-height: 1.2;
        letter-spacing: -0.02em;
        color: var(--n-7);
      }

      .cs__body :global(p),
      .cs__body :global(li) {
        font-size: 1.0625rem;
        line-height: 1.65;
        color: var(--n-6);
      }

      .cs__body :global(a) {
        color: var(--n-7);
        text-decoration: underline;
        text-decoration-color: var(--n-3);
      }

      .cs__body :global(a:hover) {
        text-decoration-color: var(--n-7);
      }

      .cs__body :global(ul),
      .cs__body :global(ol) {
        padding-left: 1.4em;
      }

      .cs__body :global(li + li) {
        margin-top: 0.4em;
      }

      .cs__body :global(strong) {
        font-weight: 500;
        color: var(--n-7);
      }

      .cs__body :global(blockquote) {
        padding: 4px 0 4px 20px;
        border-left: 2px solid var(--accent);
        color: var(--n-6);
      }

      .cs__body :global(hr) {
        max-width: 70ch;
        margin: 2.5em auto;
        border: 0;
        border-top: 1px solid var(--n-2);
      }

      .cs__body :global(img) {
        display: block;
        width: 100%;
        height: auto;
        margin: 2em auto;
        border-radius: 14px;
        box-shadow: 0 0 0 1px var(--n-2);
      }

      .cs__nav {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 20px 32px;
        max-width: 880px;
        margin: clamp(56px, 7vw, 88px) auto 0;
        padding-top: 32px;
        border-top: 1px solid var(--n-2);
      }

      .cs__next {
        display: inline-flex;
        flex-direction: column;
        gap: 6px;
        text-decoration: none;
      }

      .cs__next-label {
        font-size: 0.8125rem;
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--n-5);
      }

      .cs__next-title {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
        font-weight: 500;
        letter-spacing: -0.02em;
        color: var(--n-7);
      }

      .cs__next svg {
        flex: none;
        transition: transform 200ms var(--ease-out);
      }

      .cs__next:hover svg {
        transform: translateX(3px);
      }

      .cs__back {
        font-size: 0.9375rem;
        font-weight: 500;
        color: var(--n-5);
        text-decoration: none;
        transition: color 140ms var(--ease-out);
      }

      .cs__back:hover {
        color: var(--n-7);
        text-decoration: underline;
      }

      .foot {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 8px 24px;
        padding-block: 28px 40px;
        border-top: 1px solid var(--n-2);
        font-size: 0.8125rem;
        color: var(--n-5);
      }

      @media (max-width: 760px) {
        .nav {
          flex-wrap: wrap;
          align-content: center;
          gap: 0 12px;
          min-height: 64px;
          padding-block: 10px;
        }

        .nav::before {
          background: var(--n-0);
          backdrop-filter: none;
          border-color: var(--n-2);
        }

        .nav__links {
          order: 3;
          flex: 1 1 100%;
          gap: 20px;
          margin: 8px 0 0;
          padding-top: 8px;
          border-top: 1px solid var(--n-2);
          font-size: 0.8125rem;
          background: var(--n-0);
        }

        .nav__links-long {
          display: none;
        }

        .nav__links-short {
          display: inline;
        }

        .nav__cta {
          margin-left: auto;
        }
      }
    </style>
  </body>
</html>
