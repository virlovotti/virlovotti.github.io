---
import { caseId, leadReading, thumbnail, type Ad } from "../ads";

interface Props {
  ads: Ad[];
}

const { ads } = Astro.props;
const conversions = ads.filter((ad) => ad.type === "conversion").length;
const hooks = ads.length - conversions;
---

<figure class="index" aria-labelledby="index-count">
  <figcaption class="index__bar">
    <span class="index__count" id="index-count">
      <span class="num">{conversions}</span> conversion · <span class="num">{hooks}</span> hook
    </span>
  </figcaption>

  <div class="index__head" aria-hidden="true">
    <span>Case</span>
    <span>Type</span>
    <span class="index__result">Lead result</span>
    <span class="index__days">Days</span>
  </div>

  <ol class="index__rows">
    {
      ads.map((ad) => {
        const lead = leadReading(ad);
        const thumb = thumbnail(ad);
        return (
          <li>
            <a class="index__row" href={`#${caseId(ad)}`}>
              <span class="index__case">
                <span class="index__thumb">
                  {thumb && <img src={thumb} alt="" width="27" height="48" decoding="async" />}                </span>
                <span class="index__text">
                  <span class="index__name">{ad.name}</span>
                  <span class="index__sub">
                    {ad.type === "conversion" ? "Conversion" : "Hook"} · <span class="num">{ad.daysOnAir}</span> days
                  </span>
                </span>
              </span>
              <span class="index__type">{ad.type === "conversion" ? "Conversion" : "Hook"}</span>
              <span class="index__result">
                <span>
                  <span class="index__label">{lead.label}</span> <span class="num">{lead.value}</span>
                </span>
                {lead.delta && <span class="index__delta num"> ({lead.delta})</span>}
              </span>
              <span class="index__days num">{ad.daysOnAir}</span>
            </a>
          </li>
        );
      })
    }
  </ol>
</figure>

<style>
  .index {
    margin: 0;
    overflow: hidden;
    border-radius: 18px;
    background: var(--n-white);
    box-shadow:
      0 0 0 1px var(--n-2),
      0 2px 4px rgb(17 17 17 / 0.03),
      0 32px 64px -32px rgb(17 17 17 / 0.28);
  }

  .index__bar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 16px;
    padding: 16px 20px;
    border-bottom: 1px solid var(--n-2);
    font-size: 0.875rem;
  }

  .index__count {
    color: var(--n-5);
  }

  .index__head,
  .index__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 76px 146px 32px;
    align-items: center;
    gap: 16px;
    padding: 0 20px;
  }

  .index__head {
    height: 36px;
    font-size: 0.8125rem;
    color: var(--n-5);
    background: var(--n-0);
    border-bottom: 1px solid var(--n-2);
  }

  .index__days {
    text-align: right;
  }

  .index__rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .index__rows li + li {
    border-top: 1px solid var(--n-1);
  }

  .index__row {
    min-height: 64px;
    font-size: 0.875rem;
    color: var(--n-6);
    text-decoration: none;
    transition: background-color 140ms var(--ease-out);
  }

  .index__row:hover {
    background: var(--n-0);
  }

  .index__row:focus-visible {
    outline-offset: -2px;
  }

  .index__case {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .index__thumb {
    flex: none;
    width: 27px;
    height: 48px;
    overflow: hidden;
    border-radius: 4px;
    background:
      repeating-linear-gradient(135deg, transparent 0 5px, rgb(17 17 17 / 0.06) 5px 6px),
      var(--n-1);
    box-shadow: 0 0 0 1px rgb(17 17 17 / 0.08);
  }

  .index__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .index__name {
    font-weight: 500;
    line-height: 1.3;
    color: var(--n-7);
    text-wrap: balance;
  }

  .index__type,
  .index__label,
  .index__delta,
  .index__sub {
    color: var(--n-5);
  }

  .index__text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .index__sub {
    display: none;
    font-size: 0.8125rem;
  }

  .index__result {
    white-space: nowrap;
  }

  @media (max-width: 560px) {
    .index__head,
    .index__row {
      grid-template-columns: minmax(0, 1fr) auto;
      padding: 0 16px;
    }

    .index__bar {
      padding: 14px 16px;
    }

    .index__head,
    .index__type,
    .index__days {
      display: none;
    }

    .index__row {
      padding-block: 10px;
    }

    .index__sub {
      display: block;
    }

    .index__result {
      display: grid;
      justify-items: end;
    }

    .index__delta {
      font-size: 0.8125rem;
    }
  }
</style>
