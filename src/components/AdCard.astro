---
import { caseId, readings, type Ad } from "../ads";
import AdMedia from "./AdMedia.astro";

interface Props {
  ad: Ad;
}

const { ad } = Astro.props;
const id = caseId(ad);
const typeLabel = ad.type === "conversion" ? "Conversion" : "Hook";
const taxonomy = ad.label.split(" · ");
const rows = readings(ad);
---

<article class="case" id={id} aria-labelledby={`${id}-name`} data-rise>
  <div class="case__ground">
    <AdMedia media={ad.media} name={ad.name} />
  </div>

  <div class="case__body">
    <h3 class="case__name" id={`${id}-name`}>{ad.name}</h3>

    <div class="case__meta">
      <span class="tag" data-type={ad.type}>{typeLabel}</span>
      <ul class="case__taxonomy" aria-label="Segment, angle and awareness">
        {taxonomy.map((part) => <li>{part}</li>)}
      </ul>
    </div>

    <dl class="panel">
      {
        rows.map((row) => (
          <div class="panel__row">
            <dt>{row.label}</dt>
            <dd>
              <span class="num">{row.value}</span>
              {row.delta && <span class="panel__delta num">({row.delta})</span>}
            </dd>
          </div>
        ))
      }
      <div class="panel__row">
        <dt>Days on air</dt>
        <dd><span class="num">{ad.daysOnAir}</span></dd>
      </div>
    </dl>

    {
      ad.type === "conversion" && ad.secondaryLine && (
        <p class="case__note">{ad.secondaryLine}</p>
      )
    }
  </div>
</article>

<style>
  .case {
    display: grid;
    grid-template-columns: minmax(150px, 42%) 1fr;
    gap: clamp(20px, 2.4vw, 32px);
    padding: 12px;
    border-radius: 20px;
    background: var(--n-white);
    box-shadow:
      0 0 0 1px var(--n-2),
      0 1px 2px rgb(17 17 17 / 0.04);
    scroll-margin-top: 32px;
    transition: box-shadow 240ms var(--ease-out);
  }

  .case:target {
    box-shadow:
      0 0 0 1px var(--n-7),
      0 18px 40px -20px rgb(17 17 17 / 0.3);
  }

  .case__ground {
    display: grid;
    place-items: center;
    padding: clamp(18px, 2.2vw, 28px);
    border-radius: 12px;
    background:
      radial-gradient(120% 80% at 50% 8%, #fff 0%, var(--n-1) 58%, #e9e9e9 100%);
  }

  .case__ground > :global(.screen) {
    max-width: 236px;
  }

  .case__body {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 12px 12px 12px 0;
  }

  .case__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin: 14px 0 28px;
  }

  .case:target .tag::before {
    background: var(--accent);
    box-shadow: 0 0 0 3px rgb(166 194 63 / 0.22);
  }

  .case__name {
    margin: 0;
    font-size: clamp(1.25rem, 1.05rem + 0.6vw, 1.5rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-wrap: balance;
    color: var(--n-7);
  }

  .case__taxonomy {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 0;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
    color: var(--n-5);
  }

  .case__taxonomy li + li::before {
    content: "";
    display: inline-block;
    width: 3px;
    height: 3px;
    margin: 0 8px;
    border-radius: 50%;
    vertical-align: middle;
    background: var(--n-4);
  }

  .panel {
    margin: auto 0 0;
  }

  .panel__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 0;
    border-top: 1px solid var(--n-2);
  }

  .panel dt {
    font-size: 0.8125rem;
    color: var(--n-5);
  }

  .panel dd {
    margin: 0;
    font-size: 1rem;
    font-weight: 500;
    color: var(--n-7);
    text-align: right;
    white-space: nowrap;
  }

  .panel__delta {
    margin-left: 6px;
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--n-5);
  }

  .case__note {
    margin: 4px 0 0;
    font-size: 0.8125rem;
    color: var(--n-5);
  }

  @media (max-width: 560px) {
    .case {
      grid-template-columns: 1fr;
      gap: 4px;
    }

    .case__ground > :global(.screen) {
      max-width: 200px;
    }

    .case__body {
      padding: 16px 8px 8px;
    }
  }
</style>
