---
import type { Ad } from "../ads";
import AdMedia from "./AdMedia.astro";

interface Props {
  ad: Ad;
}

const { ad } = Astro.props;
const typeLabel = ad.type === "conversion" ? "Conversion" : "Hook";
---

<article class="ad-card">
  <AdMedia media={ad.media} name={ad.name} />
  <div class="ad-card__body">
    <p class="ad-card__badge">{typeLabel}</p>
    <h2 class="ad-card__name">{ad.name}</h2>
    <p class="ad-card__label">{ad.label}</p>

    {
      ad.type === "conversion" ? (
        <dl class="ad-card__metrics">
          <div class="ad-card__metric">
            <dt>ROAS</dt>
            <dd>{ad.roas}</dd>
          </div>
          <div class="ad-card__metric">
            <dt>CPA</dt>
            <dd>{ad.cpa}</dd>
          </div>
          <div class="ad-card__metric">
            <dt>Purchases</dt>
            <dd>{ad.purchases}</dd>
          </div>
          <div class="ad-card__metric">
            <dt>CTR</dt>
            <dd>{ad.ctr}</dd>
          </div>
          <div class="ad-card__metric">
            <dt>Days on air</dt>
            <dd>{ad.daysOnAir}</dd>
          </div>
        </dl>
      ) : (
        <dl class="ad-card__metrics">
          <div class="ad-card__metric">
            <dt>Main metric</dt>
            <dd>{ad.mainMetric}</dd>
          </div>
          <div class="ad-card__metric">
            <dt>Volume</dt>
            <dd>{ad.volume}</dd>
          </div>
          <div class="ad-card__metric">
            <dt>Days on air</dt>
            <dd>{ad.daysOnAir}</dd>
          </div>
        </dl>
      )
    }

    {ad.type === "conversion" && ad.secondaryLine ? (
      <p class="ad-card__secondary">{ad.secondaryLine}</p>
    ) : null}
  </div>
</article>

<style>
  .ad-card {
    display: flex;
    flex-direction: column;
    margin: 0;
    border: 1px solid #bbb;
    background: #fafafa;
  }

  .ad-card__body {
    padding: 0.75rem 1rem 1rem;
  }

  .ad-card__badge {
    display: inline-block;
    margin: 0 0 0.5rem;
    padding: 0.125rem 0.5rem;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #444;
    border: 1px solid #999;
    background: #e8e8e8;
  }

  .ad-card__name {
    margin: 0 0 0.25rem;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    color: #111;
  }

  .ad-card__label {
    margin: 0 0 0.75rem;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: #555;
  }

  .ad-card__metrics {
    display: grid;
    gap: 0.375rem 1rem;
    margin: 0;
    font-size: 0.8125rem;
  }

  @media (min-width: 480px) {
    .ad-card__metrics {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .ad-card__metric {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    margin: 0;
    padding: 0.25rem 0;
    border-bottom: 1px solid #ddd;
  }

  .ad-card__metric dt {
    margin: 0;
    font-weight: 500;
    color: #666;
  }

  .ad-card__metric dd {
    margin: 0;
    font-weight: 600;
    color: #222;
    text-align: right;
  }

  .ad-card__secondary {
    margin: 0.75rem 0 0;
    font-size: 0.75rem;
    color: #555;
  }
</style>
