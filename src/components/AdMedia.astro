---
import type { AdMedia as AdMediaType } from "../ads";

interface Props {
  media?: AdMediaType;
  name: string;
}

const { media, name } = Astro.props;
---

<div class="screen" data-screen>
  {
    media?.kind === "image" && (
      <button
        class="screen__open"
        type="button"
        data-lightbox-open
        data-lightbox-kind="image"
        data-lightbox-src={media.src}
        aria-label={`View full-size creative for “${name}”`}
      >
        <img
          class="screen__asset"
          src={media.src}
          alt=""
          width="1080"
          height="1920"
          loading="lazy"
          decoding="async"
        />
        <span class="screen__hint" aria-hidden="true">
          <svg viewBox="0 0 16 16" width="14" height="14">
            <path
              d="M6 2.5H3.5A1.5 1.5 0 0 0 2 4v8.5A1.5 1.5 0 0 0 3.5 14H12a1.5 1.5 0 0 0 1.5-1.5V10M9.5 2.5H13.5V6.5M7 9 13.5 2.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
      </button>
    )
  }
  {
    media?.kind === "video" && (
      <button
        class="screen__open"
        type="button"
        data-lightbox-open
        data-lightbox-kind="video"
        data-lightbox-src={media.src}
        data-lightbox-poster={media.poster}
        aria-label={`View full-size video for “${name}”`}
      >
        <video
          class="screen__asset"
          src={media.src}
          poster={media.poster}
          preload="none"
          playsinline
          muted
          aria-hidden="true"
          tabindex="-1"
        />
        <span class="screen__play-badge" aria-hidden="true">
          <svg viewBox="0 0 16 16" width="14" height="14">
            <path d="M5 3.5v9l7-4.5-7-4.5Z" fill="currentColor" />
          </svg>
          <span>Play</span>
        </span>
      </button>
    )
  }
  {
    !media && (
      <div class="screen__empty">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <rect x="3.5" y="3.5" width="17" height="17" rx="3" fill="none" stroke="currentColor" stroke-width="1.5" />
          <path d="m3.5 15.5 5-5 4 4 2.5-2.5 5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
          <path d="M4 20 20 4" stroke="currentColor" stroke-width="1.5" />
        </svg>
        <p>Creative not on file</p>
      </div>
    )
  }
</div>

<style>
  .screen {
    position: relative;
    aspect-ratio: 9 / 16;
    width: 100%;
    overflow: hidden;
    border-radius: 14px;
    background: var(--n-1);
    box-shadow:
      0 0 0 1px rgb(17 17 17 / 0.08),
      0 1px 2px rgb(17 17 17 / 0.06),
      0 12px 32px -12px rgb(17 17 17 / 0.28);
  }

  .screen__asset {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--n-2);
  }

  .screen__open {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    border-radius: inherit;
    font: inherit;
    color: inherit;
    background: transparent;
    cursor: zoom-in;
    text-align: inherit;
  }

  .screen__open:hover .screen__hint,
  .screen__open:focus-visible .screen__hint {
    opacity: 1;
  }

  .screen__hint {
    position: absolute;
    right: 10px;
    bottom: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: 1px solid rgb(255 255 255 / 0.7);
    border-radius: 999px;
    color: var(--n-7);
    background: rgb(250 250 250 / 0.92);
    opacity: 0;
    transition: opacity 160ms var(--ease-out);
  }

  .screen__play-badge {
    position: absolute;
    left: 10px;
    bottom: 10px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding: 0 12px 0 10px;
    border: 1px solid rgb(255 255 255 / 0.7);
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--n-7);
    background: rgb(250 250 250 / 0.92);
    pointer-events: none;
  }

  .screen__empty {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 10px;
    height: 100%;
    padding: 16px;
    color: var(--n-5);
    text-align: center;
    background:
      repeating-linear-gradient(
        135deg,
        transparent 0 11px,
        rgb(17 17 17 / 0.035) 11px 12px
      ),
      var(--n-1);
  }

  .screen__empty p {
    margin: 0;
    font-size: 0.8125rem;
  }
</style>
